    "version": "0.2.0",
    "configurations": [
        {"name":"Python Debugger: Current File","type":"debugpy","request":"launch","program":"${file}","console":"integratedTerminal"},
        {
            "name": "Python Debugger: Run Main",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "address": "127.0.0.1" // This forces IPv4 loopback, needed when running this while connected to uOttawa wifi
        }
    ]
}